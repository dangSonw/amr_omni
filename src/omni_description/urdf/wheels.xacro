<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Exact 4w wheel and six-roller structure from
       tests/ros2_omni_robot_sim/urdf/4w. -->
  <xacro:macro name="roller" params="parent suffix xyz rpy">
    <link name="roller_link_${suffix}">
      <visual><geometry>
        <mesh filename="package://omni_description/meshes/4w/roller.stl"/>
      </geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
      <collision><geometry>
        <mesh filename="package://omni_description/meshes/4w/roller.stl"/>
      </geometry></collision>
      <inertial><mass value="0.009"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="roller_joint_${suffix}" type="continuous">
      <parent link="${parent}"/><child link="roller_link_${suffix}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/><axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="roller_link_${suffix}">
      <selfCollide>true</selfCollide>
      <collision><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="wheel" params="parent suffix xyz rpy">
    <link name="omni_wheel_link_${suffix}">
      <visual><geometry>
        <mesh filename="package://omni_description/meshes/4w/omni_frame.stl"/>
      </geometry><material name="white"><color rgba="1 1 1 1"/></material></visual>
      <collision><geometry>
        <mesh filename="package://omni_description/meshes/4w/omni_frame.stl"/>
      </geometry></collision>
      <inertial><mass value="0.5"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
      </inertial>
    </link>
    <joint name="omni_wheel_joint_${suffix}" type="continuous">
      <parent link="${parent}"/><child link="omni_wheel_link_${suffix}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/><axis xyz="0 0 -1"/>
    </joint>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}1" xyz="0.0000 -0.0210 0.0175" rpy="-1.570796327 0 -1.570796327"/>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}2" xyz="0.0182 0.0105 0.01755" rpy="-1.570796327 0 0.523598776"/>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}3" xyz="-0.0182 0.0105 0.0175" rpy="-1.570796327 0 2.617993878"/>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}4" xyz="-0.0182 -0.0105 0.0025" rpy="-1.570796327 0 -2.617993878"/>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}5" xyz="0.0182 -0.0105 0.0025" rpy="-1.570796327 0 -0.523598776"/>
    <xacro:roller parent="omni_wheel_link_${suffix}" suffix="${suffix}6" xyz="-0.0000 0.0210 0.0025" rpy="1.570796327 0 -1.570796327"/>
  </xacro:macro>

  <xacro:macro name="four_wheels" params="parent">
    <!-- Exact upstream suffix order and poses. -->
    <xacro:wheel parent="${parent}" suffix="1" xyz="0.0656 -0.0656 0.0145" rpy="1.5708 0 0.7854"/>
    <xacro:wheel parent="${parent}" suffix="2" xyz="0.0656 0.0656 0.0145" rpy="1.5708 0 2.3562"/>
    <xacro:wheel parent="${parent}" suffix="3" xyz="-0.0656 0.0656 0.0145" rpy="1.5708 0 -2.3562"/>
    <xacro:wheel parent="${parent}" suffix="4" xyz="-0.0656 -0.0656 0.0145" rpy="1.5708 0 -0.7854"/>
  </xacro:macro>
</robot>
