# AMR Omni persistent USB symlink for LiDAR (LD19 / RPLiDAR)
# Silicon Labs CP2102 USB-to-UART Bridge (LD19 / RPLiDAR standard adapter)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", SYMLINK+="lidar", SYMLINK+="amr_lidar"
# FTDI USB Serial Device
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", SYMLINK+="lidar", SYMLINK+="amr_lidar"
