<?xml version="1.0"?>
<sdf version="1.9">
  <world name="outdoor">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <!-- Physics parameters from SPEC.md Section 3.1 -->
    <physics name="outdoor_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.55 0.65 0.75 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>25 25 30 0.45 -0.35 0.2</pose>
      <direction>-0.4 0.3 -0.85</direction>
      <diffuse>0.95 0.95 0.90 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
      <attenuation><range>100</range></attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 50m x 50m Ground Plane centered at (25, 25) -->
    <model name="outdoor_ground">
      <static>true</static>
      <pose>25 25 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="grass_visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.22 0.38 0.18 1</ambient>
            <diffuse>0.28 0.48 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Asphalt Road Intersection: 2 roads 3m width crossing at (25, 25) -->
    <model name="road_ns">
      <static>true</static>
      <pose>25 25 0.002 0 0 0</pose>
      <link name="road_ns_link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>3 50</size></plane></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="road_ew">
      <static>true</static>
      <pose>25 25 0.003 0 0 0</pose>
      <link name="road_ew_link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 3</size></plane></geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- House 1 & House 2 Landmark Models -->
    <model name="house_1">
      <static>true</static>
      <pose>15 35 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 6 5</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 6 5</size></box></geometry>
          <material>
            <ambient>0.45 0.40 0.35 1</ambient>
            <diffuse>0.65 0.58 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="house_2">
      <static>true</static>
      <pose>35 15 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7 7 5</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>7 7 5</size></box></geometry>
          <material>
            <ambient>0.35 0.40 0.45 1</ambient>
            <diffuse>0.50 0.58 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Construction Cones along road -->
    <model name="cone_1"><static>true</static><pose>23.2 20 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>
    <model name="cone_2"><static>true</static><pose>23.2 22 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>
    <model name="cone_3"><static>true</static><pose>23.2 24 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>
    <model name="cone_4"><static>true</static><pose>26.8 28 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>
    <model name="cone_5"><static>true</static><pose>26.8 30 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>
    <model name="cone_6"><static>true</static><pose>20 26.8 0.3 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.6</length></cylinder></geometry><material><ambient>0.8 0.3 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link></model>

    <!-- Dumpsters -->
    <model name="dumpster_1"><static>true</static><pose>21 32 0.8 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2.0 1.2 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 1.2 1.6</size></box></geometry><material><ambient>0.1 0.25 0.15 1</ambient><diffuse>0.15 0.35 0.2 1</diffuse></material></visual></link></model>
    <model name="dumpster_2"><static>true</static><pose>32 21 0.8 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>2.0 1.2 1.6</size></box></geometry></collision><visual name="v"><geometry><box><size>2.0 1.2 1.6</size></box></geometry><material><ambient>0.1 0.15 0.25 1</ambient><diffuse>0.15 0.2 0.35 1</diffuse></material></visual></link></model>

    <!-- Trees (Pine / Park area) -->
    <model name="trees_park">
      <static>true</static>
      <link name="link">
        <collision name="t1_c"><pose>8 8 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t1_v"><pose>8 8 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t1_fol"><pose>8 8 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>

        <collision name="t2_c"><pose>8 15 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t2_v"><pose>8 15 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t2_fol"><pose>8 15 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>

        <collision name="t3_c"><pose>14 8 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t3_v"><pose>14 8 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t3_fol"><pose>14 8 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>

        <collision name="t4_c"><pose>40 40 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t4_v"><pose>40 40 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t4_fol"><pose>40 40 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>

        <collision name="t5_c"><pose>42 35 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t5_v"><pose>42 35 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t5_fol"><pose>42 35 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>

        <collision name="t6_c"><pose>36 42 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="t6_v"><pose>36 42 2.0 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>4.0</length></cylinder></geometry><material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material></visual>
        <visual name="t6_fol"><pose>36 42 4.5 0 0 0</pose><geometry><cone><radius>1.8</radius><length>3.5</length></cone></geometry><material><ambient>0.08 0.28 0.08 1</ambient><diffuse>0.12 0.40 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dynamic Pedestrians (Pure offline geometry) -->
    <actor name="pedestrian_1">
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>23 15 0 0 0 1.57</pose></waypoint>
          <waypoint><time>10</time><pose>23 35 0 0 0 1.57</pose></waypoint>
          <waypoint><time>12</time><pose>23 35 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>22</time><pose>23 15 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>24</time><pose>23 15 0 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
      <link name="body">
        <visual name="v_torso"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.3</length></cylinder></geometry><material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.85 0.3 0.3 1</diffuse></material></visual>
        <visual name="v_head"><pose>0 0 1.55 0 0 0</pose><geometry><sphere><radius>0.14</radius></sphere></geometry><material><ambient>0.8 0.6 0.5 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material></visual>
      </link>
    </actor>

    <actor name="pedestrian_2">
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>15 27 0 0 0 0</pose></waypoint>
          <waypoint><time>12</time><pose>35 27 0 0 0 0</pose></waypoint>
          <waypoint><time>14</time><pose>35 27 0 0 0 3.14</pose></waypoint>
          <waypoint><time>26</time><pose>15 27 0 0 0 3.14</pose></waypoint>
          <waypoint><time>28</time><pose>15 27 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
      <link name="body">
        <visual name="v_torso"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.3</length></cylinder></geometry><material><ambient>0.2 0.5 0.3 1</ambient><diffuse>0.25 0.65 0.35 1</diffuse></material></visual>
        <visual name="v_head"><pose>0 0 1.55 0 0 0</pose><geometry><sphere><radius>0.14</radius></sphere></geometry><material><ambient>0.8 0.6 0.5 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material></visual>
      </link>
    </actor>

    <!-- Moving Cart Obstacle (actor-based trajectory follower) -->
    <actor name="moving_cart">
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint><time>0</time><pose>10 23 0.35 0 0 0</pose></waypoint>
          <waypoint><time>15</time><pose>40 23 0.35 0 0 0</pose></waypoint>
          <waypoint><time>17</time><pose>40 23 0.35 0 0 3.14</pose></waypoint>
          <waypoint><time>32</time><pose>10 23 0.35 0 0 3.14</pose></waypoint>
          <waypoint><time>34</time><pose>10 23 0.35 0 0 0</pose></waypoint>
        </trajectory>
      </script>
      <link name="cart_box">
        <visual name="v">
          <geometry><box><size>1.2 0.8 0.7</size></box></geometry>
          <material>
            <ambient>0.6 0.45 0.15 1</ambient>
            <diffuse>0.85 0.65 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </actor>

  </world>
</sdf>
