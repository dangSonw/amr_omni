<?xml version="1.0"?>
<package format="3">
  <name>omni_bringup</name>
  <version>0.1.0</version>
  <description>AMR Omni simulation bringup wiring.</description>
  <maintainer email="maintainer@example.com">AMR Omni Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>omni_hardware</exec_depend>
  <exec_depend>omni_localization</exec_depend>
