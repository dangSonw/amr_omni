<?xml version="1.0"?>
<sdf version="1.9">
  <world name="city_street">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <physics name="city_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.65 0.75 0.85 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>20 10 35 0.4 -0.3 0.2</pose>
      <direction>-0.3 0.2 -0.9</direction>
      <diffuse>0.95 0.95 0.92 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation><range>100</range></attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Main Asphalt Road: 60m length (x: -10 to 50), 12m width (y: -6 to 6) -->
    <model name="road_ground">
      <static>true</static>
      <pose>20 0 0 0 0 0</pose>
      <link name="road_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>70 14</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="road_visual">
          <geometry><plane><normal>0 0 1</normal><size>70 14</size></plane></geometry>
          <material>
            <ambient>0.15 0.15 0.16 1</ambient>
            <diffuse>0.22 0.22 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left Sidewalk & Curb (y = 6.75m, width = 2.5m) -->
    <model name="sidewalk_left">
      <static>true</static>
      <pose>20 7.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>70 2.5 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>70 2.5 0.2</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right Sidewalk & Curb (y = -7.25m, width = 2.5m) -->
    <model name="sidewalk_right">
      <static>true</static>
      <pose>20 -7.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>70 2.5 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>70 2.5 0.2</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Center Line Dashes (Yellow) -->
    <model name="center_stripe_1">
      <static>true</static>
      <pose>5 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>4.0 0.15 0.005</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="center_stripe_2">
      <static>true</static>
      <pose>15 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>4.0 0.15 0.005</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="center_stripe_3">
      <static>true</static>
      <pose>25 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>4.0 0.15 0.005</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="center_stripe_4">
      <static>true</static>
      <pose>35 0 0.005 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>4.0 0.15 0.005</size></box></geometry><material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual></link>
    </model>

    <!-- Parked Vehicle 1: Sedan on Right Lane (x=10, y=-4.2, yaw=0) -->
    <model name="parked_sedan_1">
      <static>true</static>
      <pose>10 -4.3 0.75 0 0 0</pose>
      <link name="chassis">
        <collision name="col"><geometry><box><size>4.4 1.9 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.4 1.9 1.5</size></box></geometry>
          <material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.2 0.35 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked Vehicle 2: Delivery Van on Right Lane (x=24, y=-4.1, yaw=0) -->
    <model name="parked_van">
      <static>true</static>
      <pose>24 -4.1 1.1 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>5.2 2.1 2.2</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.2 2.1 2.2</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parked Vehicle 3: Compact Car on Left Lane (x=18, y=4.4, yaw=0) -->
    <model name="parked_car_left">
      <static>true</static>
      <pose>18 4.4 0.7 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><box><size>3.8 1.8 1.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.8 1.8 1.4</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Road Construction Zone / Obstacle Cluster in center lane (x=16 to 19, y=0.5 to 1.5) -->
    <model name="traffic_cone_1">
      <static>true</static>
      <pose>14 0.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>1.0 0.45 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="traffic_cone_2">
      <static>true</static>
      <pose>16 1.2 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>1.0 0.45 0 1</diffuse></material></visual>
      </link>
    </model>
    <model name="traffic_barrier">
      <static>true</static>
      <pose>18 1.5 0.5 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.4 1.0</size></box></geometry><material><ambient>0.8 0.2 0.1 1</ambient><diffuse>0.9 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Pedestrian refuge island / crosswalk marker -->
    <model name="street_lamp_1">
      <static>true</static>
      <pose>8 6.5 2.5 0 0 0</pose>
      <link name="pole">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="street_lamp_2">
      <static>true</static>
      <pose>28 -6.5 2.5 0 0 0</pose>
      <link name="pole">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>5.0</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Waste Containers along curb -->
    <model name="waste_bin_1">
      <static>true</static>
      <pose>5 -6.3 0.6 0 0 0</pose>
      <link name="bin">
        <collision name="c"><geometry><box><size>0.8 1.2 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 1.2 1.2</size></box></geometry><material><ambient>0.1 0.4 0.2 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
