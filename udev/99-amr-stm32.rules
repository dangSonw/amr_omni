# AMR Omni persistent USB symlink for STM32 Microcontroller
# STMicroelectronics Virtual COM Port in FS Mode (STM32F407)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666", SYMLINK+="stm32", SYMLINK+="amr_mcu"
# QinHeng Electronics CH340 / CH341 (USB-to-UART module)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", SYMLINK+="stm32", SYMLINK+="amr_mcu"
# QinHeng Electronics CH343 / CH340K
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", MODE="0666", SYMLINK+="stm32", SYMLINK+="amr_mcu"
