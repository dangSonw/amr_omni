<?xml version="1.0"?>
<sdf version="1.9">
  <world name="dynamic_traffic">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <physics name="dynamic_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.65 1.0</ambient>
      <background>0.5 0.6 0.7 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>15 10 30 0.5 -0.3 0.1</pose>
      <direction>-0.35 0.2 -0.9</direction>
      <diffuse>0.95 0.95 0.92 1.0</diffuse>
      <specular>0.3 0.3 0.3 1.0</specular>
      <attenuation><range>100</range></attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Test Track Ground 60m x 40m -->
    <model name="test_ground">
      <static>true</static>
      <pose>20 10 0 0 0 0</pose>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>65 45</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>65 45</size></plane></geometry>
          <material>
            <ambient>0.2 0.22 0.24 1</ambient>
            <diffuse>0.28 0.3 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Central Traffic Roundabout Island (x=15, y=5, radius=3m) -->
    <model name="roundabout_island">
      <static>true</static>
      <pose>15 5 0.25 0 0 0</pose>
      <link name="island_link">
        <collision name="c"><geometry><cylinder><radius>2.5</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.5</radius><length>0.5</length></cylinder></geometry><material><ambient>0.2 0.45 0.2 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Center Monument on Roundabout -->
    <model name="roundabout_pillar">
      <static>true</static>
      <pose>15 5 1.5 0 0 0</pose>
      <link name="pillar_link">
        <collision name="c"><geometry><cylinder><radius>0.6</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.6</radius><length>2.5</length></cylinder></geometry><material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Slalom & Obstacle Chicane 1: Sudden pop-up cylinder obstacle in straight path -->
    <model name="obstacle_pillar_1">
      <static>true</static>
      <pose>5 2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry><material><ambient>0.9 0.2 0.1 1</ambient><diffuse>1.0 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Slalom Obstacle 2 -->
    <model name="obstacle_pillar_2">
      <static>true</static>
      <pose>9 -1 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry><material><ambient>0.9 0.2 0.1 1</ambient><diffuse>1.0 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Slalom Obstacle 3 -->
    <model name="obstacle_pillar_3">
      <static>true</static>
      <pose>21 11 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry><material><ambient>0.9 0.2 0.1 1</ambient><diffuse>1.0 0.3 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Narrow Gate / Tunnel Choke Point (Tests lateral clearance & MPPI evasion) -->
    <model name="choke_left">
      <static>true</static>
      <pose>26 3 0.75 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.4 1.5 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 1.5 1.5</size></box></geometry><material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.9 0.6 0.15 1</diffuse></material></visual></link>
    </model>
    <model name="choke_right">
      <static>true</static>
      <pose>26 7 0.75 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.4 1.5 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 1.5 1.5</size></box></geometry><material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.9 0.6 0.15 1</diffuse></material></visual></link>
    </model>

    <!-- Blind Corner Obstacle Wall (L-shape to test radar/lidar dynamic detection of emerging obstacles) -->
    <model name="blind_wall_1">
      <static>true</static>
      <pose>32 5 1.0 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.0 0.3 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>4.0 0.3 2.0</size></box></geometry><material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
    <model name="blind_wall_2">
      <static>true</static>
      <pose>34 7 1.0 0 0 1.5708</pose>
      <link name="l"><collision name="c"><geometry><box><size>4.0 0.3 2.0</size></box></geometry></collision><visual name="v"><geometry><box><size>4.0 0.3 2.0</size></box></geometry><material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>

    <!-- Simulated Cross-Traffic Obstacle Pod (x=10, y=9, size 1.0m cube) -->
    <model name="traffic_pod">
      <static>true</static>
      <pose>10 9 0.5 0 0 0.4</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.2 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 1.0</size></box></geometry><material><ambient>0.1 0.4 0.7 1</ambient><diffuse>0.2 0.55 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
